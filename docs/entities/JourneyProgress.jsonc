{
  "name": "JourneyProgress",
  "type": "object",
  "properties": {
    "step": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "active",
        "done"
      ]
    },
    "completed_date": {
      "type": "string",
      "format": "date"
    }
  },
  "required": [
    "step",
    "status"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}