{
  "name": "WeighIn",
  "type": "object",
  "properties": {
    "date": {
      "type": "string",
      "format": "date"
    },
    "weight": {
      "type": "number",
      "description": "kg"
    }
  },
  "required": [
    "date"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}